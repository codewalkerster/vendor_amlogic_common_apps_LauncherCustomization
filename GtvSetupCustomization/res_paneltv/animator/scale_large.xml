<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_standard" android:duration="150" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleX"/>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_standard" android:duration="150" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleY"/>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_standard" android:duration="150" android:valueTo="0dp" android:valueType="floatType" android:propertyName="elevation"/>
        </set>
    </item>
    <item android:state_focused="true">
        <set>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_enter" android:duration="300" android:valueTo="1.075" android:valueType="floatType" android:propertyName="scaleX"/>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_enter" android:duration="300" android:valueTo="1.075" android:valueType="floatType" android:propertyName="scaleY"/>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_enter" android:duration="300" android:valueTo="3dp" android:valueType="floatType" android:propertyName="elevation"/>
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_exit" android:duration="500" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleX"/>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_exit" android:duration="500" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleY"/>
            <objectAnimator android:interpolator="@interpolator/gtvm3_sys_motion_easing_tv_exit" android:duration="500" android:valueTo="0dp" android:valueType="floatType" android:propertyName="elevation"/>
        </set>
    </item>
</selector>
