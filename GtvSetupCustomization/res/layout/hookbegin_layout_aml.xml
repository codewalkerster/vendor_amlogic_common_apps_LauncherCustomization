<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        style="@style/Widget.GtvMaterial3.DialogContainer">
        <TextView
            android:text="@string/tv_mode_title"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.GtvMaterial3.DialogTitle"/>
        <FrameLayout
            android:gravity="center"
            android:layout_gravity="left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.GtvMaterial3.DialogBody">
            <TextView
                android:gravity="left"
                android:layout_gravity="center"
                android:text="@string/tv_mode_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.GtvMaterial3.DialogMessage"/>
        </FrameLayout>

        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/button_consumer"
                android:text="@string/tv_mode_consumer"
                android:visibility="gone"
                android:layout_marginEnd="@dimen/gtvm3_dialog_actions_spacing"/>
            <Button
                android:id="@+id/button_business"
                android:text="@string/tv_mode_demo"
		    android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
